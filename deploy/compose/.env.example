# MAK4I Enterprise Self-Hosted — Developer Preview configuration.
#
#   cp .env.example .env
#   chmod 600 .env        # this file holds the database password
#
# Developer Preview only: a chmod-600 .env file on a single VM is an
# acceptable place for these secrets while evaluating. A production
# deployment keeps the control-plane database URL in a secret manager,
# never in a plaintext file (docs/DEPLOYMENT.md, "Security considerations").
#
# Every MAK4I_* runtime variable is documented in docs/DEPLOYMENT.md,
# "Runtime configuration". compose.yaml sets the fixed ones (transport,
# bind address, store backend, artifact path) itself; only the values
# below are yours to choose.

# --- Control-plane database (PostgreSQL 16, internal to Compose) ---------

# REQUIRED. Use a long random value made only of URL-safe characters
# (letters and digits) — it is embedded in a postgresql:// URL.
# Generate one with:  openssl rand -hex 32
POSTGRES_PASSWORD=

# Optional; defaults shown.
POSTGRES_USER=mak4i
POSTGRES_DB=mak4i

# --- How clients reach MAK4I ---------------------------------------------

# The full MCP URL your AI clients will connect to, including /mcp.
# `mak4i credential issue` prints ready-to-paste connect commands with it.
#   With the tls profile:  https://<MAK4I_DOMAIN>/mcp
#   Without TLS:           http://127.0.0.1:8080/mcp (local/SSH-tunnel only)
MAK4I_PUBLIC_ENDPOINT=https://mak4i.example.com/mcp

# Only for `docker compose --profile tls ...`: the DNS name Caddy obtains
# a certificate for. Its A/AAAA record must point at this VM, and ports
# 80 and 443 must be open.
MAK4I_DOMAIN=mak4i.example.com

# Where the MCP server's plain-HTTP port is published on the host.
# Keep 127.0.0.1 unless you understand the risk: 0.0.0.0 serves bearer
# credentials over unencrypted HTTP to your network.
MAK4I_HTTP_BIND=127.0.0.1
MAK4I_HTTP_PORT=8080
